{
  "name": "morada",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n WEB,API -c cyan,green \"npm run start:web\" \"npm run start:api\"",
    "start:web": "ng serve --proxy-config proxy.conf.json",
    "start:api": "node --watch mock-server/server.mjs",
    "test:api": "node --test mock-server/app.test.mjs mock-server/domain/normalize-text.test.mjs mock-server/domain/search-properties.test.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:single-spa": "ng run morada:build-single-spa:production",
    "serve:single-spa": "ng run morada:serve-single-spa:development",
    "lint": "ng lint",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,scss,css,md,yml,yaml}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "single-spa": ">=4.0.0",
    "single-spa-angular": "^20.1.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "20.0.0",
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.7.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "style-loader": "^3.3.1",
    "supertest": "^7.2.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.68.0"
  }
}
